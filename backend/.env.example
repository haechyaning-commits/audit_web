# 실제 값은 .env 파일(git에 커밋 안 됨, .gitignore 참고)에 넣고 사용하세요.

# Railway Postgres 서비스 → Connect 탭 → DATABASE_PUBLIC_URL
DATABASE_URL=postgresql://postgres:비밀번호@호스트:포트/railway

# OpenAI API 키 (상세페이지 4줄 요약 온디맨드 생성용, platform.openai.com에서 발급)
OPENAI_API_KEY=sk-...

# 배포된 프론트엔드(Vercel) origin (CORS 허용용). 로컬 개발(localhost:5173)은 기본으로 항상 허용되므로
# 로컬에서만 쓸 땐 비워둬도 됨.
FRONTEND_ORIGIN=https://your-app.vercel.app

# "데이터 오류 신고" 목록 조회(GET /admin/reports?token=...) 접근용 비밀 토큰. 비워두면
# 그 엔드포인트는 항상 403 — 로그인 시스템이 없는 프로젝트라 URL에 붙이는 공유 비밀
# 토큰 방식을 씀. 아무 무작위 문자열이나 넣고(예: openssl rand -hex 16), 이 값을 아는
# 사람만 /admin/reports?token=이값 으로 접속해서 신고 목록을 볼 수 있음.
ADMIN_TOKEN=
